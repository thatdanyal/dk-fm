{
  "name": "dk-fm",
  "productName": "DK.FM",
  "version": "1.0.0",
  "description": "Retro desktop music player with Spotify playlist import and local library.",
  "author": "thatdanyal",
  "license": "MIT",
  "private": true,
  "main": "src/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/thatdanyal/dk-fm.git"
  },
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "release": "electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "music-metadata": "^7.14.0"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.5.1": true
  },
  "build": {
    "appId": "com.thatdanyal.dkfm",
    "productName": "DK.FM",
    "artifactName": "DK.FM-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.png",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio",
      "icon": "build/icon.png",
      "maintainer": "thatdanyal <thatdanyal@users.noreply.github.com>",
      "synopsis": "Retro desktop music player"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "thatdanyal",
        "repo": "dk-fm",
        "releaseType": "release"
      }
    ],
    "electronLanguages": [
      "en-US"
    ],
    "compression": "maximum"
  }
}
